{
  "name": "construction-tender-saas",
  "version": "0.1.0",
  "description": "UK Construction Tendering Marketplace - Prototype",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "tsx --test tests/lib/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:seed-fake-tenders": "tsx --env-file=.env scripts/seed-fake-tenders.ts",
    "retention:purge": "tsx --env-file=.env scripts/purge-retention.ts",
    "health:audit": "node scripts/health-check/run-audit.mjs",
    "health:validate-workflows": "node scripts/health-check/validate-workflows.mjs",
    "health:verify-approval": "node scripts/health-check/verify-approval.mjs",
    "health:verify-deploy-approval": "node scripts/health-check/verify-deployment-approval.mjs",
    "health:verify-deployment": "node scripts/health-check/verify-deployment.mjs",
    "health:email": "tsx scripts/health-check/send-report-email.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.72.0",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.292.0",
    "nanoid": "^3.3.18",
    "next": "^14.0.0",
    "next-auth": "^4.24.15",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.31",
    "prisma": "6.19.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "resend": "^6.24.0",
    "stripe": "^22.6.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "zod": "^4.4.3",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.0",
    "tsx": "^4.23.12"
  }
}
